{
  "info": {
    "name": "CompetencyHub",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Run the folders in order (Collection Runner works). Each create request saves the new id into a collection variable, so later requests use it automatically.\n\nFolder 3 creates real submissions, so folder 4's 409 checks work without any SQL. (Before submissions had an endpoint, this was the manual way:)\n\ndocker exec competencyhub-db psql -U chub -d competencyhub -c \"INSERT INTO submission (student_id, assessment_id, score, submitted_at) VALUES ((SELECT min(id) FROM student), <objectiveId>, 90, now())\""
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "courseCode",
      "value": "CS777"
    },
    {
      "key": "courseId",
      "value": ""
    },
    {
      "key": "competency1Id",
      "value": ""
    },
    {
      "key": "competency2Id",
      "value": ""
    },
    {
      "key": "objectiveId",
      "value": ""
    },
    {
      "key": "performanceId",
      "value": ""
    },
    {
      "key": "mentorId",
      "value": ""
    },
    {
      "key": "studentId",
      "value": "1"
    },
    {
      "key": "essaySubmissionId",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Happy path",
      "item": [
        {
          "name": "Create course",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/courses",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "courses"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"code\": \"{{courseCode}}\",\n  \"title\": \"Verify Course\",\n  \"capacity\": 10\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Change courseCode in the collection variables if it already exists (409)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"status is 201\", () => pm.response.to.have.status(201));",
                  "pm.collectionVariables.set(\"courseId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Create competency 1 (no orderIndex)",
