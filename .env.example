# ---------------------------------------------------------------------------
# Template for the server's .env (used by docker-compose.prod.yml).
#   cp .env.example .env   then fill in real values.   NEVER commit .env.
# Generate strong values on the server with:   openssl rand -base64 24
# ---------------------------------------------------------------------------

# Postgres credentials. The database is created with these on the FIRST start;
# changing them later does not change the existing database user.
DB_USERNAME=chub_prod
DB_PASSWORD=chub_prod_password

# First admin (ProdAdminBootstrap). Needed only on the first start of an empty
# database. Remove ADMIN_PASSWORD from .env once you have logged in.
ADMIN_EMAIL=dineshsarma551@gmail.com
ADMIN_PASSWORD=admin-password-123

# Image tag to run. "latest" = newest build from main; CD sets sha-xxxxxxx.
APP_TAG=latest